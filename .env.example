# Claude authentication
# "login" (default): uses your Claude Code login - run `claude login` once.
#   For headless runs, set a token from `claude setup-token` instead.
# "api_key": uses ANTHROPIC_API_KEY with the Anthropic API.
CLAUDE_AUTH=login
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=your-anthropic-api-key

CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4000

# Google Cloud Text-to-Speech (path to service-account JSON key)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# YouTube Data API (OAuth client downloaded from Google Cloud Console)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_PRIVACY=private

# Video settings
OUTPUT_DIR=output
VIDEO_MIN_SECONDS=30
VIDEO_MAX_SECONDS=60
VIDEO_MAX_ITERATIONS=3
